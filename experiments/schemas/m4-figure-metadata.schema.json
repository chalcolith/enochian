{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/m4-figure-metadata-1.json",
  "type": "array",
  "minItems": 3,
  "maxItems": 3,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "id",
      "path",
      "title",
      "alt_text",
      "encoding",
      "run_id",
      "source_artifacts",
      "sha256"
    ],
    "properties": {
      "id": {
        "enum": [
          "primary-effect",
          "language-distributions",
          "subsample-stability"
        ]
      },
      "path": { "$ref": "#/$defs/path" },
      "title": { "type": "string", "minLength": 1 },
      "alt_text": { "type": "string", "minLength": 1 },
      "encoding": { "type": "string", "minLength": 1 },
      "run_id": { "$ref": "#/$defs/hash" },
      "source_artifacts": {
        "type": "array",
        "minItems": 1,
        "items": { "$ref": "#/$defs/path" }
      },
      "sha256": { "$ref": "#/$defs/hash" }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)" }
  }
}
