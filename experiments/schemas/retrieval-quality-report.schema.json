{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/retrieval-quality-report-1.json",
  "title": "Enochian retrieval benchmark quality report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "benchmark_id", "passed", "blockers", "reviews", "score_rows", "summary_rows"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "benchmark_id": { "type": "string", "minLength": 1 },
    "passed": { "type": "boolean" },
    "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
    "reviews": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["total_records", "completed_records", "accepted_records", "rejected_records", "accuracy", "passed", "blockers", "error_categories"],
        "properties": {
          "total_records": { "type": "integer", "minimum": 0 },
          "completed_records": { "type": "integer", "minimum": 0 },
          "accepted_records": { "type": "integer", "minimum": 0 },
          "rejected_records": { "type": "integer", "minimum": 0 },
          "accuracy": { "type": "number", "minimum": 0, "maximum": 1 },
          "passed": { "type": "boolean" },
          "blockers": { "type": "array", "uniqueItems": true, "items": { "type": "string" } },
          "error_categories": {
            "type": "object",
            "additionalProperties": { "type": "integer", "minimum": 1 }
          }
        }
      }
    },
    "score_rows": { "type": "integer", "minimum": 0 },
    "summary_rows": { "type": "integer", "minimum": 0 }
  }
}
