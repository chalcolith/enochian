{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/mapping-symbol-inventory-1.json",
  "title": "Evaluation-only Voynich symbol inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "inventory_id", "transcription", "evaluation_loci", "holdout_opened", "symbols"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "inventory_id": { "type": "string", "minLength": 1 },
    "transcription": { "$ref": "#/$defs/pin" },
    "evaluation_loci": { "const": ["f1r", "f1v", "f2r", "f2v"] },
    "holdout_opened": { "const": false },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["symbol", "token_count", "loci"],
        "properties": {
          "symbol": { "type": "string", "minLength": 1 },
          "token_count": { "type": "integer", "minimum": 1 },
          "loci": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["f1r", "f1v", "f2r", "f2v"] }
          }
        }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)" },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
