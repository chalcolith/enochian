{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/sequence-null-1.json",
  "title": "Enochian generated sequence null",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "sample_id", "requested_size", "null_id", "is_null", "null_kind", "analysis_mode", "weight", "repetition", "null_repetition", "seed", "generator_version", "language", "query_id", "query_length", "phones"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "sample_id": { "type": "string", "minLength": 1 },
    "requested_size": { "type": "integer", "minimum": 1 },
    "null_id": { "type": "string", "pattern": "^null\\." },
    "is_null": { "const": true },
    "null_kind": { "enum": ["unigram-pseudoword", "biphone-pseudoword", "mapping-assignment-shuffle", "within-query-shuffle"] },
    "analysis_mode": { "enum": ["type-primary", "token-weighted"] },
    "weight": { "type": "integer", "minimum": 1 },
    "repetition": { "type": "integer", "minimum": 1 },
    "null_repetition": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "generator_version": { "const": "balanced-nulls-v1" },
    "language": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "query_length": { "type": "integer", "minimum": 1 },
    "phones": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "minItems": 1,
        "items": { "type": "number" }
      }
    }
  }
}
