{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/m4-final-report-manifest-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "report_id", "run_id", "status", "source_run_manifest",
    "source_artifacts", "report_artifacts", "decision_rule_outcome",
    "matching_or_statistics_rerun", "definitions_present", "holdout_present"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "report_id": { "const": "m4-04-final-holdout-report-v1" },
    "run_id": { "$ref": "#/$defs/hash" },
    "status": { "const": "completed" },
    "source_run_manifest": { "$ref": "#/$defs/artifact" },
    "source_artifacts": {
      "type": "array", "minItems": 10,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "report_artifacts": {
      "type": "array", "minItems": 1,
      "items": { "$ref": "#/$defs/artifact" }
    },
    "decision_rule_outcome": { "enum": ["met", "not_met"] },
    "matching_or_statistics_rerun": { "const": false },
    "definitions_present": { "const": false },
    "holdout_present": { "const": true }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)" },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/hash" },
        "bytes": { "type": "integer", "minimum": 0 }
      }
    }
  }
}
