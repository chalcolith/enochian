{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/voynich-evaluation-query-1.json",
  "title": "Definitions-free Voynich evaluation query type",
  "type": "object",
  "additionalProperties": false,
  "required": ["query_id", "locus", "symbols", "token_frequency"],
  "properties": {
    "query_id": { "type": "string", "pattern": "^eva-type-[0-9]{4}$" },
    "locus": { "enum": ["f1r", "f1v", "f2r", "f2v"] },
    "symbols": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[a-z]$" }
    },
    "token_frequency": { "type": "integer", "minimum": 1 }
  }
}
