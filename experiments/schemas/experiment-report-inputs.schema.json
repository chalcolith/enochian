{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/experiment-report-inputs-1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "run_id", "config_id", "statistical_tables"],
  "properties": {
    "schema_version": { "const": "1.0.0" }, "run_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "config_id": { "type": "string" },
    "statistical_tables": { "type": "array", "items": { "type": "object", "additionalProperties": false, "required": ["path", "sha256", "bytes"], "properties": { "path": { "type": "string" }, "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "bytes": { "type": "integer", "minimum": 0 } } } }
  }
}
