{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/mapping-preregistration-1.json",
  "title": "Voynich mapping decision package and preregistration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "preregistration_id", "status", "comparative_results_inspected", "partitions", "features", "ipa_encoding", "inventory", "candidates", "proposal_candidate_id", "decision", "outputs"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0.0" },
    "preregistration_id": { "type": "string", "minLength": 1 },
    "status": { "enum": ["pending", "approved", "declined"] },
    "comparative_results_inspected": { "const": false },
    "partitions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluation_loci", "holdout_loci", "holdout_opened"],
      "properties": {
        "evaluation_loci": { "const": ["f1r", "f1v", "f2r", "f2v"] },
        "holdout_loci": { "const": ["f3r", "f3v", "f4r", "f4v"] },
        "holdout_opened": { "const": false }
      }
    },
    "features": { "$ref": "#/$defs/pin" },
    "ipa_encoding": { "$ref": "#/$defs/pin" },
    "inventory": {
      "oneOf": [
        { "$ref": "#/$defs/pin" },
        { "type": "null" }
      ]
    },
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/candidate" }
    },
    "proposal_candidate_id": {
      "type": ["string", "null"],
      "minLength": 1
    },
    "decision": {
      "oneOf": [
        { "$ref": "#/$defs/decision" },
        { "type": "null" }
      ]
    },
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["report_json", "report_markdown"],
      "properties": {
        "report_json": { "$ref": "#/$defs/path" },
        "report_markdown": { "$ref": "#/$defs/path" }
      }
    }
  },
  "$defs": {
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)" },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "strings": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "kind", "description", "source", "linguistic_rationale", "differences_from_legacy", "normalization", "segmentation", "transcription_ambiguities", "symbol_to_ipa", "materialized_mapping"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
        "kind": { "enum": ["legacy", "proposal"] },
        "description": { "type": "string", "minLength": 1 },
        "source": {
          "oneOf": [
            { "$ref": "#/$defs/pin" },
            { "type": "null" }
          ]
        },
        "linguistic_rationale": { "type": "string", "minLength": 1 },
        "differences_from_legacy": { "$ref": "#/$defs/strings" },
        "normalization": {
          "type": "object",
          "additionalProperties": false,
          "required": ["unicode_normalization", "case_treatment", "uncertain_symbols"],
          "properties": {
            "unicode_normalization": { "const": "NFC" },
            "case_treatment": { "type": "string", "minLength": 1 },
            "uncertain_symbols": { "type": "string", "minLength": 1 }
          }
        },
        "segmentation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["method", "multigraphs", "overlap_resolution"],
          "properties": {
            "method": { "type": "string", "minLength": 1 },
            "multigraphs": { "$ref": "#/$defs/strings" },
            "overlap_resolution": { "type": "string", "minLength": 1 }
          }
        },
        "transcription_ambiguities": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["input", "treatment", "rationale"],
            "properties": {
              "input": { "type": "string", "minLength": 1 },
              "treatment": { "type": "string", "minLength": 1 },
              "rationale": { "type": "string", "minLength": 1 }
            }
          }
        },
        "symbol_to_ipa": {
          "oneOf": [
            {
              "type": "object",
              "minProperties": 1,
              "additionalProperties": { "type": "string", "minLength": 1 }
            },
            { "type": "null" }
          ]
        },
        "materialized_mapping": {
          "oneOf": [
            { "$ref": "#/$defs/path" },
            { "type": "null" }
          ]
        }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "researcher", "decided_on", "rationale", "candidate_id", "mapping_sha256"],
      "properties": {
        "status": { "enum": ["approved", "declined"] },
        "researcher": { "type": "string", "minLength": 1 },
        "decided_on": { "type": "string", "format": "date" },
        "rationale": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": ["string", "null"], "minLength": 1 },
        "mapping_sha256": {
          "oneOf": [
            { "type": "string", "pattern": "^[a-f0-9]{64}$" },
            { "type": "null" }
          ]
        }
      }
    }
  }
}
