{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/sample-membership-1.json",
  "title": "Enochian balanced sample membership",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "analysis_id", "analysis_set", "sample_id", "repetition", "requested_size", "seed", "generator_version", "language", "length_band", "frequency_band", "candidate_id", "lemma", "phonology", "entry_kind", "source_memberships"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "analysis_id": { "type": "string", "minLength": 1 },
    "analysis_set": { "enum": ["primary", "full", "inflected"] },
    "sample_id": { "type": "string", "minLength": 1 },
    "repetition": { "type": "integer", "minimum": 1 },
    "requested_size": { "type": "integer", "minimum": 1 },
    "seed": { "type": "integer", "minimum": 0 },
    "generator_version": { "const": "balanced-nulls-v1" },
    "language": { "type": "string", "minLength": 1 },
    "length_band": { "type": "string", "minLength": 1 },
    "frequency_band": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "lemma": { "type": "string" },
    "phonology": { "type": "string", "minLength": 1 },
    "entry_kind": { "type": "string", "minLength": 1 },
    "source_memberships": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["entry_id", "source_id", "source_record_id"],
        "properties": {
          "entry_id": { "type": "string", "minLength": 1 },
          "source_id": { "type": "string", "minLength": 1 },
          "source_record_id": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
