{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/scored-match-1.json",
  "title": "Enochian scored lexicon match",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "record_id",
    "configuration_id",
    "query_id",
    "query_text",
    "query_phoneme_length",
    "lexicon_id",
    "source_id",
    "language",
    "family",
    "candidate_id",
    "candidate_lemma",
    "candidate_form",
    "candidate_phoneme_length",
    "raw_cost",
    "path_length",
    "mean_path_cost",
    "mean_input_length_cost",
    "within_lexicon_rank"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "record_id": { "type": "string", "minLength": 1 },
    "configuration_id": { "type": "string", "minLength": 1 },
    "query_id": { "type": "string", "minLength": 1 },
    "query_text": { "type": "string" },
    "query_phoneme_length": { "type": "integer", "minimum": 0 },
    "lexicon_id": { "type": "string", "minLength": 1 },
    "source_id": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "minLength": 1 },
    "family": { "type": "string", "minLength": 1 },
    "candidate_id": { "type": "string", "minLength": 1 },
    "candidate_lemma": { "type": "string" },
    "candidate_form": { "type": ["string", "null"] },
    "candidate_phoneme_length": { "type": "integer", "minimum": 0 },
    "raw_cost": { "type": "number", "minimum": 0 },
    "path_length": { "type": "integer", "minimum": 0 },
    "mean_path_cost": { "type": "number", "minimum": 0 },
    "mean_input_length_cost": { "type": "number", "minimum": 0 },
    "within_lexicon_rank": { "type": "integer", "minimum": 1 }
  }
}
