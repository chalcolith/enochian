{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/degradation-profile-1.json",
  "title": "Enochian retrieval degradation profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "id", "version", "language_neutral", "operations"],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "language_neutral": { "const": true },
    "operations": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "every", "offset"],
            "properties": {
              "kind": { "const": "deletion" },
              "every": { "type": "integer", "minimum": 2 },
              "offset": { "type": "integer", "minimum": 0 }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "features"],
            "properties": {
              "kind": { "const": "feature_merger" },
              "features": {
                "type": "array",
                "minItems": 2,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "features"],
            "properties": {
              "kind": { "const": "feature_masking" },
              "features": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        ]
      }
    }
  }
}
