{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/inflected-form-1.json",
  "title": "Enochian separately retained inflected form",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "entry_id", "source_record_id", "source", "source_version", "language", "lemma", "form", "entry_kind", "script", "transliteration", "features", "unicode_normalization", "license"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "entry_id": { "type": "string", "pattern": "^[a-z0-9._-]+:[a-z]{3}:form:[0-9]{8}$" },
    "source_record_id": { "type": "string", "pattern": "^form:[0-9]{8}$" },
    "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "source_version": { "type": "string", "minLength": 1 },
    "language": { "type": "string", "pattern": "^[a-z]{3}$" },
    "lemma": { "type": "string", "minLength": 1 },
    "form": { "type": "string", "minLength": 1 },
    "entry_kind": { "const": "inflected_form" },
    "script": { "type": "string", "minLength": 1 },
    "transliteration": { "type": ["string", "null"], "minLength": 1 },
    "features": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "unicode_normalization": { "const": "NFC" },
    "license": { "type": "string", "minLength": 1 }
  }
}
