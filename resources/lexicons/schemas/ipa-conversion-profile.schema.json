{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/ipa-conversion-profile-1.json",
  "title": "Enochian IPA conversion profile",
  "description": "Versioned metadata for a provider and language-specific conversion profile.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "provider_id",
    "provider_version",
    "profile_id",
    "profile_version",
    "provider_kind",
    "language",
    "input_normalization",
    "output_notation",
    "execution_boundary",
    "packages"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "provider_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "provider_version": { "type": "string", "minLength": 1 },
    "profile_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "profile_version": { "type": "string", "minLength": 1 },
    "provider_kind": { "enum": ["external", "custom"] },
    "language": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "input_normalization": { "const": "NFC" },
    "output_notation": { "const": "IPA" },
    "execution_boundary": { "const": "out-of-process" },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "version", "license"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "license": { "type": "string", "minLength": 1 }
        }
      }
    },
    "notes": { "type": ["string", "null"] }
  }
}
