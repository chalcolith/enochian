{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/source-manifest-1.json",
  "title": "Enochian lexicon source manifest",
  "description": "Version 1 provenance contract for an acquired lexicon source.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_id",
    "status",
    "owner",
    "language",
    "family",
    "url",
    "revision",
    "retrieval_date",
    "sha256",
    "license",
    "license_status",
    "distribution_policy",
    "usage_policy",
    "optional",
    "default_bundle",
    "citation",
    "parser",
    "raw_path",
    "generated_artifact_path",
    "filters"
  ],
  "properties": {
    "$schema": { "type": "string", "format": "uri-reference" },
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$" },
    "source_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "status": { "enum": ["planned", "acquired"] },
    "owner": { "type": "string", "minLength": 1 },
    "language": { "$ref": "#/$defs/language_code" },
    "family": { "type": "string", "minLength": 1 },
    "url": { "type": "string", "format": "uri" },
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value"],
      "properties": {
        "kind": { "enum": ["commit", "tag", "release", "unresolved"] },
        "value": { "type": "string", "minLength": 1 }
      }
    },
    "retrieval_date": { "type": ["string", "null"], "format": "date" },
    "sha256": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "license": {
      "enum": [
        "Apache-2.0",
        "BSD-2-Clause",
        "CC-BY-4.0",
        "CC-BY-NC-4.0",
        "CC-BY-SA-3.0",
        "CC-BY-SA-4.0",
        "GPL-2.0-or-later",
        "LGPL-2.1-or-later",
        "MIT",
        "MPL-1.1",
        "NOASSERTION"
      ]
    },
    "license_status": { "enum": ["verified", "unverified"] },
    "distribution_policy": { "enum": ["vendored", "download-on-demand", "metadata-only"] },
    "usage_policy": { "enum": ["unrestricted", "non-commercial", "unverified"] },
    "optional": { "type": "boolean" },
    "default_bundle": { "type": "boolean" },
    "citation": { "type": "string", "minLength": 1 },
    "parser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "raw_path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
    "generated_artifact_path": { "oneOf": [{ "$ref": "#/$defs/path" }, { "type": "null" }] },
    "filters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["include", "exclude"],
      "properties": {
        "include": { "$ref": "#/$defs/string_array" },
        "exclude": { "$ref": "#/$defs/string_array" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "acquired" } }, "required": ["status"] },
      "then": {
        "properties": {
          "revision": {
            "type": "object",
            "properties": { "kind": { "enum": ["commit", "tag", "release"] } }
          },
          "retrieval_date": { "type": "string" },
          "sha256": { "type": "string" },
          "raw_path": { "$ref": "#/$defs/path" }
        }
      }
    },
    {
      "if": { "properties": { "license_status": { "const": "unverified" } }, "required": ["license_status"] },
      "then": { "properties": { "default_bundle": { "const": false } } }
    },
    {
      "if": { "properties": { "usage_policy": { "const": "non-commercial" } }, "required": ["usage_policy"] },
      "then": {
        "properties": {
          "optional": { "const": true },
          "default_bundle": { "const": false }
        }
      }
    }
  ],
  "$defs": {
    "language_code": {
      "type": "string",
      "pattern": "^[a-z]{2,3}(?:-[A-Z][a-z]{3})?(?:-(?:[A-Z]{2}|[0-9]{3}))?$"
    },
    "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:|/|\\\\)" },
    "string_array": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
