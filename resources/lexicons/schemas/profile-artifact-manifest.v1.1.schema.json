{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/profile-artifact-manifest-1.1.json",
  "title": "M2-10 per-reading proof provenance envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile", "profile_sha256", "panel_sha256", "software_sha256", "feature_sha256", "encoding_sha256", "source_manifests", "artifacts", "status", "blockers", "provenance"],
  "properties": {
    "schema_version": { "const": "1.1.0" },
    "profile": { "type": "object" },
    "profile_sha256": { "$ref": "#/$defs/hash" },
    "panel_sha256": { "$ref": "#/$defs/hash" },
    "software_sha256": { "$ref": "#/$defs/hash" },
    "feature_sha256": { "$ref": "#/$defs/hash" },
    "encoding_sha256": { "$ref": "#/$defs/hash" },
    "source_manifests": { "type": "array", "items": { "$ref": "#/$defs/pin" } },
    "artifacts": { "type": "array", "minItems": 3, "items": { "$ref": "#/$defs/pin" } },
    "status": { "const": "exploratory" },
    "blockers": { "type": "array", "items": { "type": "string" } },
    "provenance": {
      "type": "object", "additionalProperties": false, "required": ["parent", "package", "proofs"],
      "properties": {
        "parent": { "$ref": "#/$defs/pin" },
        "package": { "$ref": "#/$defs/pin" },
        "proofs": { "$ref": "#/$defs/pin" }
      }
    }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "pin": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/hash" }
      }
    }
  }
}
