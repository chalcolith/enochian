{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/pronunciation-panel-1.json",
  "title": "Versioned dictionary-first pronunciation panel",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "frozen", "dictionary_protocol", "dictionary_protocol_sha256", "output_directory", "report_directory", "fallback_source_manifests", "profiles"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "type": "string", "minLength": 1 },
    "frozen": { "const": true },
    "dictionary_protocol": { "type": "string", "minLength": 1 },
    "dictionary_protocol_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "output_directory": { "type": "string", "minLength": 1 },
    "report_directory": { "type": "string", "minLength": 1 },
    "fallback_source_manifests": { "$ref": "#/$defs/strings" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "language", "convention", "required_labels", "rejected_labels", "fallback", "rules"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "version": { "type": "string", "pattern": "^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$" },
          "language": { "type": "string", "pattern": "^[a-z]{3}$" },
          "convention": { "type": "string", "minLength": 1 },
          "required_labels": { "$ref": "#/$defs/strings" },
          "rejected_labels": { "$ref": "#/$defs/strings" },
          "fallback": { "enum": ["none", "classical-arabic-vocalized-v1"] },
          "rules": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "strings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
