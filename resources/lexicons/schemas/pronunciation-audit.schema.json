{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://chalcolith.github.io/enochian/schemas/pronunciation-audit-1.json",
  "title": "Dictionary pronunciation coverage audit protocol",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "frozen", "dump_date", "extraction_date", "extractor_revision", "processor_revision", "source_manifests", "output_directory", "report_directory", "policy", "languages"],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "policy_id": { "type": "string", "minLength": 1 },
    "frozen": { "const": true },
    "dump_date": { "type": "string", "format": "date" },
    "extraction_date": { "type": "string", "format": "date" },
    "extractor_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "processor_revision": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "source_manifests": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "output_directory": { "type": "string", "minLength": 1 },
    "report_directory": { "type": "string", "minLength": 1 },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["minimum_lemmas", "minimum_per_band", "minimum_references", "minimum_agreement", "minimum_phonemes", "maximum_phonemes", "required_bands", "admitted_origins"],
      "properties": {
        "minimum_lemmas": { "type": "integer", "minimum": 100 },
        "minimum_per_band": { "type": "integer", "minimum": 25 },
        "minimum_references": { "type": "integer", "minimum": 100 },
        "minimum_agreement": { "type": "number", "minimum": 0.95, "maximum": 1 },
        "minimum_phonemes": { "const": 3 },
        "maximum_phonemes": { "const": 20 },
        "required_bands": { "const": ["03-05", "06-09", "10-20"] },
        "admitted_origins": { "const": ["dictionary-supplied"] }
      }
    },
    "languages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["language", "dictionary_code", "family", "convention", "required_labels", "rejected_labels"],
        "properties": {
          "language": { "type": "string", "pattern": "^[a-z]{3}$" },
          "dictionary_code": { "type": "string", "pattern": "^[a-z]{2,3}$" },
          "family": { "type": "string", "minLength": 1 },
          "convention": { "type": "string", "minLength": 1 },
          "required_labels": { "$ref": "#/$defs/labels" },
          "rejected_labels": { "$ref": "#/$defs/labels" },
          "lexicon_path": { "type": ["string", "null"], "minLength": 1 },
          "reference_path": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    }
  },
  "$defs": {
    "labels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
